#!/sbin/sh
# Standard Magisk module installer entry point. It delegates extraction and installation to
# Magisk's own util_functions implementation.

umask 022
ui_print() { echo "$1"; }

require_new_magisk() {
    ui_print "*******************************"
    ui_print " Magisk 20.4 or newer is required "
    ui_print "*******************************"
    exit 1
}

OUTFD=$2
ZIPFILE=$3
mount /data 2>/dev/null

[ -f /data/adb/magisk/util_functions.sh ] || require_new_magisk
. /data/adb/magisk/util_functions.sh
[ "$MAGISK_VER_CODE" -ge 20400 ] || require_new_magisk

install_module
exit 0
